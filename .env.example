# Google APIs
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PAGESPEED_KEY=your_google_pagespeed_api_key_here

# Google Service Account
# Create service account and download JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Place the JSON file in /config/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./config/google-service-account.json

# Google Sheets
# Get the Sheet ID from the URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
SHEET_ID=your_google_sheet_id_here

# Email Service (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager (Optional)
# Get your GTM ID from: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
